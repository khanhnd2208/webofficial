{
	"name": "khanhwebsite",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"predev": "prisma generate",
		"build": "next build --webpack",
		"prisma:generate": "prisma generate",
		"postinstall": "prisma generate",
		"prebuild": "npm run prisma:generate",
		"start": "next start",
		"lint": "eslint",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"areas:check": "node scripts/areas/sync.mjs",
		"areas:sync": "node scripts/areas/sync.mjs --write",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:unit": "vitest run --project unit && npm run test:lint-tooling && npm run test:deploy-tooling",
		"test:integration": "vitest run --project integration",
		"test:component": "vitest run --project component",
		"test:all": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:db:setup": "bash scripts/setup-test-db.sh",
		"check": "npm run typecheck && npm run lint -- --max-warnings=0 && npm run format:check && npm run areas:check && npm run test:all && npm audit --omit=dev --audit-level=moderate && npm run build",
		"prepare": "node .husky/install.mjs",
		"db:seed": "npx tsx prisma/seed.ts",
		"db:seed:my-class": "npx tsx scripts/seed-my-class.ts",
		"db:sync:active-recall": "npx tsx scripts/replace-active-recall-revisions.ts",
		"db:seed:teaching": "npx tsx scripts/seed-teaching.ts",
		"db:seed:teaching:excel": "npx tsx scripts/seed-teaching-from-excel.ts",
		"db:normalize-teaching": "npx tsx scripts/normalize-teaching-classes.ts",
		"db:seed:itm": "npx tsx scripts/seed-itm-course.ts",
		"db:migrate": "npx prisma migrate dev",
		"db:migrate:deploy": "npx prisma migrate deploy",
		"db:studio": "npx prisma studio",
		"deploy:vps": "bash scripts/deploy-vps.sh",
		"test:lint-tooling": "node --test scripts/vendor/next-eslint-glob/*.test.mjs scripts/design-lint.test.mjs",
		"test:deploy-tooling": "node --test scripts/deploy-prune-releases.test.mjs"
	},
	"prisma": {
		"seed": "npx tsx prisma/seed.ts"
	},
	"dependencies": {
		"@auth/mongodb-adapter": "^3.11.3",
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/modifiers": "^9.0.0",
		"@dnd-kit/sortable": "^10.0.0",
		"@dnd-kit/utilities": "^3.2.2",
		"@prisma/adapter-pg": "^7.7.0",
		"@prisma/client": "^7.9.1",
		"@tailwindcss/typography": "^0.5.19",
		"@tanstack/react-table": "^8.21.3",
		"@tiptap/extension-code-block-lowlight": "^3.19.0",
		"@tiptap/extension-color": "^3.19.0",
		"@tiptap/extension-highlight": "^3.19.0",
		"@tiptap/extension-image": "^3.19.0",
		"@tiptap/extension-link": "^3.19.0",
		"@tiptap/extension-placeholder": "^3.19.0",
		"@tiptap/extension-subscript": "^3.19.0",
		"@tiptap/extension-superscript": "^3.19.0",
		"@tiptap/extension-table": "^3.19.0",
		"@tiptap/extension-table-cell": "^3.19.0",
		"@tiptap/extension-table-header": "^3.19.0",
		"@tiptap/extension-table-row": "^3.19.0",
		"@tiptap/extension-text-align": "^3.19.0",
		"@tiptap/extension-text-style": "^3.19.0",
		"@tiptap/extension-underline": "^3.19.0",
		"@tiptap/extension-youtube": "^3.19.0",
		"@tiptap/markdown": "^3.31.3",
		"@tiptap/pm": "^3.19.0",
		"@tiptap/react": "^3.19.0",
		"@tiptap/starter-kit": "^3.19.0",
		"bcryptjs": "^3.0.3",
		"canvas-confetti": "^1.9.4",
		"csv-parse": "^7.0.2",
		"diff": "^9.0.0",
		"dotenv": "^17.4.2",
		"dotenv-expand": "^13.0.0",
		"framer-motion": "^12.34.0",
		"isomorphic-dompurify": "^3.22.0",
		"lowlight": "^3.3.0",
		"mermaid": "^12.0.0",
		"mongodb": "^6.21.0",
		"mongoose": "^9.9.3",
		"nanoid": "^5.1.16",
		"next": "^16.3.6",
		"next-auth": "^5.0.0-beta.32",
		"pg": "^8.20.0",
		"react": "^19.2.4",
		"react-dom": "^19.2.4",
		"react-image-crop": "^11.0.10",
		"react-markdown": "^10.1.0",
		"react-qr-code": "^2.2.0",
		"read-excel-file": "^9.3.10",
		"remark-breaks": "^4.0.0",
		"remark-gfm": "^4.0.1",
		"server-only": "^0.0.1",
		"sharp": "^0.35.5",
		"write-excel-file": "^4.1.1",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@playwright/test": "^1.61.0",
		"@tailwindcss/postcss": "^4",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.1",
		"@types/bcryptjs": "^2.4.6",
		"@types/canvas-confetti": "^1.9.0",
		"@types/node": "^25.2.3",
		"@types/pg": "^8.20.0",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"@vitest/coverage-v8": "^4.1.11",
		"eslint": "^9.39.2",
		"eslint-config-next": "^16.3.8",
		"eslint-config-prettier": "^10.1.8",
		"husky": "^9.1.7",
		"jsdom": "^29.1.1",
		"lint-staged": "^17.0.8",
		"mongodb-memory-server": "^11.2.0",
		"prettier": "^3.8.4",
		"prisma": "^7.9.1",
		"tailwindcss": "^4",
		"tsx": "4.23.12",
		"typescript": "^5",
		"vitest": "^4.1.11",
		"@webofficial/next-eslint-glob": "file:./scripts/vendor/next-eslint-glob"
	},
	"lint-staged": {
		"*.{ts,tsx,mjs}": [
			"eslint --fix",
			"prettier --write"
		],
		"*.{json,css,yml}": [
			"prettier --write"
		]
	},
	"overrides": {
		"linkify-it": "^6.1.0",
		"lodash-es": "^4.18.1",
		"markdown-it": "^15.0.0",
		"deepmerge-ts": "^8.0.2",
		"mysql2": "^3.22.0",
		"katex": "^0.19.0",
		"postcss-selector-parser": "^7.1.6",
		"@next/eslint-plugin-next": {
			"fast-glob": "file:../../../scripts/vendor/next-eslint-glob"
		}
	}
}
