# MongoDB
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@HOST/DATABASE?retryWrites=true&w=majority

# NextAuth / Auth.js
# Development:
NEXTAUTH_URL=http://localhost:3000
# Production (REQUIRED on VPS):
# NEXTAUTH_URL=https://your-domain.com

# Auth.js and inquiry rate-limit HMAC (required in production).
# AUTH_SECRET is preferred; NEXTAUTH_SECRET remains supported for compatibility.
AUTH_SECRET=replace-with-a-strong-secret
NEXTAUTH_SECRET=replace-with-a-strong-secret

# Google OAuth (Phase 2)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# RBAC (legacy - role is now read from database)
ADMIN_EMAIL=email_admin_cua_ban@gmail.com

# CRITICAL FOR PRODUCTION:
# When deploying behind Nginx reverse proxy, ensure:
# 1. trustHost: true is set in auth config (already done in code)
# 2. NEXTAUTH_URL uses https://
# 3. Nginx headers are set: X-Forwarded-Proto, X-Forwarded-Host, X-Real-IP

# Admin secret token — visit /admin?token=VALUE to authenticate
ADMIN_SECRET=replace-with-a-strong-secret-token

# Inquiry delivery (all three values are required in production).
# In local development, inquiries may still be saved with email status "pending".
RESEND_API_KEY=
INQUIRY_FROM_EMAIL="Duy Khánh <noreply@your-domain.com>"
INQUIRY_NOTIFY_EMAIL=you@example.com

# Umami analytics (optional — no-op when unset; never send PII)
NEXT_PUBLIC_UMAMI_SCRIPT_URL=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
