// ════════════════════════════════════════════════════════════════════════
// Prisma Schema — Vocabulary Module
// Part of the Hybrid DB strategy: MongoDB handles auth/blog/users,
// PostgreSQL (this schema) handles vocabulary with relational integrity.
//
// userId fields are TEXT referencing MongoDB User._id (string ObjectId).
// ════════════════════════════════════════════════════════════════════════

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// ─── VocabSet ─────────────────────────────────────────────────────────────────
// Canonical vocabulary set created and owned by an admin.
// ownerId references MongoDB User._id as a plain string.
model VocabSet {
  id          String   @id @default(cuid())
  title       String
  description String   @default("")
  ownerId     String   // MongoDB User._id
  ownerName   String
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  words          Word[]
  userVocabSets  UserVocabSet[]
  gameScores     GameScore[]

  @@index([ownerId])
  @@index([isArchived, updatedAt(sort: Desc)])
}

// ─── Word ─────────────────────────────────────────────────────────────────────
// Individual vocabulary term belonging to a VocabSet.
// Soft-delete via isDeleted=true to hide from UI without losing data.
model Word {
  id             String   @id @default(cuid())
  vocabSetId     String
  term           String
  definition     String
  partOfSpeech   String   @default("")
  example        String   @default("")
  isDeleted      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // ── v2: NDK's Explanation & Guess Who hints ──────────────────────────────
  ndkExplanation String?    // Teacher's personal explanation (nullable)
  hintsHard      String[]   // Hard hints (few, cryptic) for Guess Who game
  hintsMedium    String[]   // Medium hints for Guess Who game
  hintsEasy      String[]   // Easy hints for Guess Who game

  vocabSet VocabSet @relation(fields: [vocabSetId], references: [id], onDelete: Cascade)

  @@index([vocabSetId, isDeleted])
}

// ─── UserVocabSet ─────────────────────────────────────────────────────────────
// Junction table: a user's library entry for a VocabSet.
// status='active'       → visible in user's library
// status='soft_deleted' → hidden from UI, can be restored on re-download
model UserVocabSet {
  id         String            @id @default(cuid())
  userId     String            // MongoDB User._id
  vocabSetId String
  status     UserVocabSetStatus @default(active)
  addedAt    DateTime          @default(now())
  deletedAt  DateTime?

  vocabSet VocabSet @relation(fields: [vocabSetId], references: [id], onDelete: Cascade)

  @@unique([userId, vocabSetId])
  @@index([userId, status])
}

// ─── GameScore ────────────────────────────────────────────────────────────────
// Stores each user's personal best score per mode per vocab set.
// Only updated when new score > existing best.
// Score scale: MCQ/FILL_BLANK → 0–3000 (avg per question)
//              MATCHING/GUESS_WHO → 0–10000 (session total)
model GameScore {
  id         String   @id @default(cuid())
  userId     String   // MongoDB User._id
  userName   String
  vocabSetId String
  mode       GameMode
  score      Float    // personal best

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  vocabSet VocabSet @relation(fields: [vocabSetId], references: [id], onDelete: Cascade)

  @@unique([userId, vocabSetId, mode])
  @@index([vocabSetId, mode, score(sort: Desc)])
}

enum UserVocabSetStatus {
  active
  soft_deleted
}

enum GameMode {
  MCQ
  FILL_BLANK
  MATCHING
  GUESS_WHO
}

// ─── Daily Logic Puzzle Module ────────────────────────────────────────────────
// userId fields reference MongoDB User._id as plain string (same as GameScore).

model DailyPuzzle {
  id           String            @id @default(cuid())
  dateKey      String            @unique // YYYY-MM-DD in Asia/Ho_Chi_Minh
  title        String
  size         Int
  layoutJson   Json
  solutionJson Json
  difficulty   PuzzleDifficulty  @default(MEDIUM)
  puzzleKind   PuzzleKind        @default(DAILY)
  status       PuzzleStatus      @default(DRAFT)
  validatorVersion   String?
  validatedAt        DateTime?
  layoutHash         String?
  solutionHash       String?
  validationStatus   PuzzleValidationStatus @default(PENDING)
  createdBy    String            @default("system")
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  attempts     PuzzleAttempt[]
  leaderboard  PuzzleLeaderboardEntry[]

  @@index([status, dateKey(sort: Desc)])
}

model PuzzleAttempt {
  id               String              @id @default(cuid())
  puzzleId         String
  userId           String
  userName         String
  startedAt        DateTime
  submittedAt      DateTime?
  durationMs       Int?
  mistakes                 Int                 @default(0)
  status                   PuzzleAttemptStatus @default(IN_PROGRESS)
  clientEventsJson         Json?
  progressJson             Json?
  notesJson                Json?
  eligibleForLeaderboard   Boolean             @default(true)

  puzzle DailyPuzzle @relation(fields: [puzzleId], references: [id], onDelete: Cascade)

  @@unique([userId, puzzleId])
  @@index([puzzleId, status])
}

model PuzzleLeaderboardEntry {
  id          String   @id @default(cuid())
  puzzleId    String
  userId      String
  userName    String
  durationMs  Int
  mistakes    Int
  rankScore   Int
  submittedAt DateTime @default(now())

  puzzle DailyPuzzle @relation(fields: [puzzleId], references: [id], onDelete: Cascade)

  @@unique([userId, puzzleId])
  @@index([puzzleId, rankScore(sort: Asc)])
}

model PuzzleUserStats {
  id                 String   @id @default(cuid())
  userId             String   @unique
  currentStreak      Int      @default(0)
  longestStreak      Int      @default(0)
  lastSolvedDateKey  String?
  totalSolved        Int      @default(0)
  updatedAt          DateTime @updatedAt
}

enum PuzzleDifficulty {
  EASY
  MEDIUM
  HARD
}

enum PuzzleStatus {
  DRAFT
  VALIDATED
  PUBLISHED
  ARCHIVED
}

enum PuzzleKind {
  DAILY
  TUTORIAL
}

enum PuzzleValidationStatus {
  PENDING
  VALID
  INVALID
}

enum PuzzleAttemptStatus {
  IN_PROGRESS
  SOLVED
  FAILED
  ABANDONED
}
