{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"permissions": {
		"allow": [
			"Bash(npm run typecheck)",
			"Bash(npm run lint *)",
			"Bash(npm run format:check)",
			"Bash(npm run areas:check)",
			"Bash(npm run test:unit *)",
			"Bash(npm run test:component *)",
			"Bash(npm run test:integration *)",
			"Bash(npx tsc --noEmit)",
			"Bash(npx tsc --noEmit *)",
			"Bash(npx vitest run --project unit *)",
			"Bash(npx vitest run --project component *)",
			"Bash(npx eslint *)",
			"Bash(npx prettier --check *)",
			"Bash(npx prisma validate)",
			"Bash(npm view *)",
			"Bash(npm ls)",
			"Bash(npm ls *)",
			"mcp__Claude_Browser__get_page_text",
			"mcp__Claude_Browser__find",
			"mcp__Claude_Browser__read_console_messages"
		],
		"ask": [
			"Bash(git push)",
			"Bash(git push *main*)",
			"Bash(gh pr merge *)",
			"Bash(npm run deploy:vps *)",
			"Bash(bash scripts/deploy-vps.sh *)",
			"Bash(./scripts/deploy-vps.sh *)",
			"Bash(scripts/deploy-vps.sh *)",
			"Bash(ssh webofficial-vps *)",
			"Bash(npm run db:migrate *)",
			"Bash(npx prisma migrate *)",
			"Bash(npx prisma db push *)"
		],
		"deny": [
			"Bash(git push *--force*)",
			"Bash(git push * -f *)",
			"Bash(git push -f *)",
			"Read(./.env)",
			"Read(./.env.local)",
			"Read(./.env.test)",
			"Read(./.env.test.local)",
			"Read(./.env.development*)",
			"Read(./.env.production*)",
			"Read(./.next/**)",
			"Read(./coverage/**)",
			"Read(./test-results/**)",
			"Read(./playwright-report/**)",
			"Read(./outputs/**)",
			"Read(./package-lock.json)",
			"Read(**/*.tsbuildinfo)",
			"Read(./docs/ui-ux-expert-review.html)",
			"Read(./docs/references/**)"
		]
	},
	"hooks": {
		"SessionStart": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh"
					}
				]
			}
		]
	}
}
